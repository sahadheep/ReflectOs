<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Structured JSON logging for production observability.
         Every log line includes the correlation ID (requestId) from CorrelationIdFilter. -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-no-request}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON appender for structured logging (activate via 'json' profile) -->
    <springProfile name="json,prod,production">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","logger":"%logger","requestId":"%X{requestId:-none}","thread":"%thread","message":"%msg"}%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON" />
        </root>
    </springProfile>

    <!-- Default console output for development -->
    <springProfile name="!json,!prod,!production">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- Reduce noise from framework internals -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.flywaydb" level="INFO" />
    <logger name="com.reflectos" level="DEBUG" />
</configuration>
